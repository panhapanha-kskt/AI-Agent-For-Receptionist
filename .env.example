# Copy to .env and fill in. NEVER commit .env.

# --- LLM: Google Gemini ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# AI Studio keys start with "AIza". Set true only for a Google Cloud Vertex AI (express mode) key.
GEMINI_VERTEXAI=false
# Used automatically when the main model is overloaded (429/5xx) or times out. Empty = none.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Fast model for questions whose answer is already attached (routed skill / approved answer)
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# low = fastest for fact look-ups (recommended); medium/high think longer and are slower
THINKING_LEVEL=low
LLM_TIMEOUT_MS=20000
# Attempts per model (1 = no retry); retries use exponential backoff with jitter
LLM_RETRY_ATTEMPTS=2

# --- Skill router (answers most questions in 1 model call instead of 3) ---
ROUTER_ENABLED=true
# Semantic matching with Gemini embeddings (false = keywords only, no extra API calls)
ROUTER_EMBEDDINGS=true
EMBEDDING_MODEL=gemini-embedding-2
# Route when the best skill scores >= threshold AND leads the 2nd skill by >= margin
ROUTER_THRESHOLD=0.65
ROUTER_MARGIN=0.03
# Staff-approved answers are matched on the server before calling the LLM
KNOWLEDGE_THRESHOLD=0.85

# --- App ---
SCHOOL_NAME=Example Academy
ENVIRONMENT=development
DATABASE_URL=sqlite:///./receptionist.db
SKILLS_DIR=./skills
# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:8000

# --- Admin ---
# Long random secret, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- Limits ---
MAX_AUDIO_BYTES=10485760
MAX_AUDIO_SECONDS=120
MAX_TEXT_CHARS=1000
RATE_LIMIT=20/minute
# Long chats: summarise older turns after this many messages (0 = never); hard reset at MAX_HISTORY_TURNS
SUMMARIZE_AFTER_TURNS=10
MAX_HISTORY_TURNS=40

# --- Speech-to-text (faster-whisper) ---
STT_ENABLED=false
STT_MODEL_EN=small
# Path to a Khmer fine-tuned Whisper converted to CTranslate2 (see README). Empty = use STT_MODEL_EN.
STT_MODEL_KM=
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# --- Text-to-speech ---
# browser = the web page speaks the reply (no server model); mms = Meta MMS (non-commercial licence!)
TTS_PROVIDER=browser
# Pin to a specific Hugging Face commit hash in production
TTS_MMS_REVISION=main
